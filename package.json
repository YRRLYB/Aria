{
  "name": "aria",
  "private": true,
  "version": "0.2.15-beta.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "ensure:mpv": "node scripts/ensure-mpv.cjs",
    "dev": "npm run build:server && concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "dev:electron": "electron .",
    "build:web": "vite build",
    "build:server": "node -e \"require('node:fs').rmSync('dist-server',{recursive:true,force:true})\" && esbuild server/index.ts --bundle --platform=node --format=cjs --external:NeteaseCloudMusicApi --outfile=dist-server/index.cjs && node scripts/copy-ncm-runtime.cjs",
    "build:desktop": "npm run ensure:mpv && npm run build:web && npm run build:server",
    "dist:beta": "npm run build:desktop && electron-builder --win nsis --x64",
    "start:server": "node dist-server/index.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.13.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.2"
  },
  "build": {
    "appId": "com.yrrlyb.aria",
    "productName": "Aria",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "vendor/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-server/node_modules/**/*",
      "vendor/mpv/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Aria-${version}-${arch}.${ext}",
      "shortcutName": "Aria",
      "uninstallDisplayName": "Aria"
    }
  }
}
